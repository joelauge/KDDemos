{
  "name": "knowbot",
  "private": true,
  "type": "module",
  "description": "KnowBot server: the only runtime dependency is the Anthropic SDK, loaded lazily for bots that answer with Claude.",
  "scripts": {
    "start": "node server/server.mjs",
    "test": "node --test --test-concurrency=6 \"scripts/test/*.test.mjs\" \"lib/test/*.test.mjs\" \"server/test/*.test.mjs\"",
    "test:area": "node scripts/test-area.mjs",
    "stamp": "node scripts/stamp-assets.mjs",
    "stamp:strip": "node scripts/stamp-assets.mjs --strip",
    "stamp:check": "node scripts/stamp-assets.mjs --check",
    "site:build": "node scripts/build-site.mjs",
    "studio:dev": "node studio/test/dev-server.mjs",
    "studio:smoke": "node studio/test/smoke.mjs",
    "leads:smoke": "node studio/test/leads-smoke.mjs",
    "site:smoke": "node studio/test/site-smoke.mjs",
    "voice:smoke": "node studio/test/voice-smoke.mjs",
    "tools:smoke": "node studio/test/tools-shots.mjs",
    "ftue:smoke": "node studio/test/ftue-smoke.mjs",
    "kd:smoke": "node studio/test/kd-smoke.mjs",
    "builder:eval": "node scripts/builder-eval.mjs",
    "onboarding:e2e": "node studio/test/onboarding-e2e.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0"
  }
}
