# Copy to .env (git-ignored) for local runs: `cp .env.example .env`, then fill in values. Never commit .env.
# The live server does NOT read this file: add the same names as GitHub encrypted secrets on
# Recourse-Software-Inc/knowbot (environment "github-pages"); the deploy workflow passes them to the Worker.

# KnowBot Studio Builder (Claude Haiku 5.5)
ANTHROPIC_API_KEY=
KNOWBOT_STUDIO_PROVIDER=anthropic
KNOWBOT_STUDIO_MODEL=claude-haiku-5-5

# knowDrive store the bots answer from (local runs against a real store only)
KNOWDRIVE_API_KEY=

# Phone channel (Twilio Voice) and SMS. Each is optional; a feature without its secret stays off ("not configured").
# Twilio: signs every webhook (TWILIO_AUTH_TOKEN); the account SID lets the phone agent hang up and text links.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number product-link texts are sent from (E.164, e.g. +15551234567).
TWILIO_FROM_NUMBER=
# Gemini Live voice-to-voice phone engine (aistudio.google.com/apikey). Without it calls use the classic speech loop.
GEMINI_API_KEY=
# GEMINI_LIVE_MODEL=gemini-3.8-live
# GEMINI_VOICE=Kore
# The same key powers the web voice assistant (lib/voice-widget.js, embed data-mode="voice"); without it the widget uses
# the browser's own speech recognition and voice. Limits: KNOWBOT_WEBVOICE_MAX_SECONDS=600, KNOWBOT_WEBVOICE_MAX_SESSIONS=50,
# KNOWBOT_WEBVOICE_RATE_LIMIT=6 (sessions per minute per IP).
# Classic phone engine voice (ElevenLabs). Without it: Google TTS when configured, else Twilio's own voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional: a Shopify storefront for texted checkout links (a trial bot built from a Shopify store import uses that store).
# SHOP_DOMAIN=https://your-store.example
