{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "knowbot-api",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "vars": { "SITE_URL": "https://knowbot.knowdrive.ai", "KNOWBOT_RATE_LIMIT": "30" },
  "containers": [
    {
      "class_name": "KnowBotContainer",
      "image": "./Dockerfile",
      "image_build_context": "..",
      "instance_type": "standard-4",
      "max_instances": 1
    }
  ],
  "durable_objects": { "bindings": [{ "name": "KNOWBOT", "class_name": "KnowBotContainer" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["KnowBotContainer"] }]
}
