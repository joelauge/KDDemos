{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "knowbot-api",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "vars": { "SITE_URL": "https://knowbot.knowdrive.ai", "KNOWBOT_PROOF_URL": "https://knowbot.knowdrive.ai", "KNOWBOT_EVIDENCE_BOTS": "tr_6ajxk3z2gxkzrbwi,ugm", "KNOWBOT_RATE_LIMIT": "30", "KNOWBOT_STUDIO_PROVIDER": "anthropic", "KNOWBOT_STUDIO_MODEL": "claude-haiku-5-5" },
  "containers": [
    {
      "class_name": "KnowBotContainer",
      "image": "./Dockerfile",
      "image_build_context": "..",
      "instance_type": "standard-4",
      "max_instances": 1
    }
  ],
  "durable_objects": { "bindings": [{ "name": "KNOWBOT", "class_name": "KnowBotContainer" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["KnowBotContainer"] }]
}
