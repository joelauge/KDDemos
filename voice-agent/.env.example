# ── Public URL ────────────────────────────────────────────────────────────
# The HTTPS address Twilio uses to reach this server (an ngrok/cloudflared
# tunnel in development, your host in production). No trailing slash.
PUBLIC_BASE_URL=https://your-tunnel.ngrok-free.app
PORT=3000

# ── KnowDrive (the canonical source) ──────────────────────────────────────
# The demo test store lives on the public deployment. Use https://knowdrive.ai
# for a store on the main deployment.
KNOWDRIVE_BASE_URL=https://public.knowdrive.ai
# An API token holding: functions:/api/v1/search:read and
# vector_stores:<KNOWDRIVE_VECTOR_STORE_ID>:read. Sent as X-API-TOKEN.
KNOWDRIVE_API_TOKEN=
# Store id (vs_...) or name to answer from (on the host above).
KNOWDRIVE_VECTOR_STORE_ID=
# Optional: limit answers to vetted files, e.g. "canonical" or "canonical,!draft".
KNOWDRIVE_TAG_QUERY=
# Number of passages handed to the model per question.
KNOWDRIVE_TOP_K=6

# ── Claude (writes the spoken answer from the passages) ───────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low keeps phone turns quick; raise to medium for harder questions.
CLAUDE_EFFORT=low

# ── ElevenLabs (text to speech) ───────────────────────────────────────────
ELEVENLABS_API_KEY=
# Any voice id from your ElevenLabs voice library.
ELEVENLABS_VOICE_ID=
# eleven_flash_v2_5 is the low-latency model; eleven_multilingual_v2 sounds richer but is slower.
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_22050_32

# ── Twilio (phone calls) ──────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number callers dial (E.164, e.g. +15551234567).
TWILIO_PHONE_NUMBER=
# Set to false only for local testing without Twilio signatures.
TWILIO_VALIDATE_SIGNATURE=true
TWILIO_SPEECH_MODEL=phone_call
TWILIO_LANGUAGE=en-US

# ── Persona ───────────────────────────────────────────────────────────────
AGENT_NAME=Kay
ORG_NAME=KnowDrive
GREETING=Hi, this is Kay from KnowDrive. I answer straight from our knowledge base. What would you like to know?
