# ── Public URL ────────────────────────────────────────────────────────────
# The HTTPS address Twilio uses to reach this server (an ngrok/cloudflared
# tunnel in development, your host in production). No trailing slash.
PUBLIC_BASE_URL=https://your-tunnel.ngrok-free.app
PORT=3000

# ── KnowDrive (the canonical source) ──────────────────────────────────────
# The demo store lives on the dev deployment.
KNOWDRIVE_BASE_URL=https://dev.knowdrive.ai
# A developer key from the same deployment (dev.knowdrive.ai), able to read
# the store below. Sent as X-API-TOKEN (a JWT is sent as a Bearer token).
# KNOWDRIVE_API_KEY works as an alternative name.
KNOWDRIVE_API_TOKEN=
# Store id (vs_...) or name to answer from (on the host above).
# Default: knowbot-ugm, the customer knowledge base for The Ultimate Game Master.
KNOWDRIVE_VECTOR_STORE_ID=vs_f66318f0dd0e4540b27663b03ea40f40
# Optional: limit answers to vetted files, e.g. "canonical" or "canonical,!draft".
KNOWDRIVE_TAG_QUERY=!kind:article
# Number of passages handed to the model per question.
KNOWDRIVE_TOP_K=6

# ── Voice engine ──────────────────────────────────────────────────────────
# gemini:  voice-to-voice. Twilio streams call audio to Gemini Live, which
#          listens and speaks directly; KnowDrive search is a tool it calls.
#          Needs GEMINI_API_KEY. Claude and ElevenLabs are not used.
# classic: Twilio speech-to-text -> KnowDrive -> Claude -> ElevenLabs voice.
VOICE_ENGINE=classic

# ── Gemini Live (VOICE_ENGINE=gemini) ─────────────────────────────────────
# API key from Google AI Studio (aistudio.google.com/apikey).
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
# A Gemini prebuilt voice name, e.g. Kore, Puck, Charon, Aoede.
GEMINI_VOICE=Kore

# ── Texted checkout links (VOICE_ENGINE=gemini) ───────────────────────────
# The Shopify storefront. When set, the agent offers to text a link that adds
# the product to the cart and opens checkout. Leave empty to turn this off.
SHOP_DOMAIN=https://theultimategamemaster.com
# Attribution tags on every texted link. ref shows as the referral code in the
# order's conversion summary; the order notes also get the call id.
LINK_UTM_SOURCE=ai-assistant
LINK_UTM_MEDIUM=sms
LINK_UTM_CAMPAIGN=voice-agent
LINK_REF=ai-voice-agent

# ── Claude (writes the spoken answer from the passages) ───────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low keeps phone turns quick; raise to medium for harder questions.
CLAUDE_EFFORT=low

# ── ElevenLabs (text to speech) ───────────────────────────────────────────
ELEVENLABS_API_KEY=
# Any voice id from your ElevenLabs voice library.
ELEVENLABS_VOICE_ID=
# eleven_flash_v2_5 is the low-latency model; eleven_multilingual_v2 sounds richer but is slower.
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_22050_32

# ── Twilio (phone calls) ──────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number callers dial (E.164, e.g. +15551234567).
TWILIO_PHONE_NUMBER=
# Set to false only for local testing without Twilio signatures.
TWILIO_VALIDATE_SIGNATURE=true
TWILIO_SPEECH_MODEL=phone_call
TWILIO_LANGUAGE=en-US

# ── Persona ───────────────────────────────────────────────────────────────
AGENT_NAME=Kay
ORG_NAME="The Ultimate Game Master"
GREETING="Hi, this is Kay at The Ultimate Game Master. I can help with products, prices, shipping and returns. What can I do for you?"
